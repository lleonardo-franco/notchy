#!/bin/bash
APP="/Applications/Notchy.app"
BUNDLE="io.github.lleonardo-franco.notchy"
IDENTITY="Notchy Local Signing"
STATE="$HOME/Library/Application Support/Notchy"
REPO_URL="https://github.com/lleonardo-franco/notchy.git"
HOMEBREW="${NOTCHY_HOMEBREW:-0}"

notchy_language() {
    local value="${NOTCHY_LANG:-}"
    if [ -z "$value" ]; then
        value=$(defaults read -g AppleLanguages 2>/dev/null | sed -n '2p' | tr -d ' ",')
    fi
    [ -z "$value" ] && value="${LC_ALL:-${LANG:-en}}"
    case "$value" in
        pt*) echo pt ;;
        es*) echo es ;;
        *) echo en ;;
    esac
}

NOTCHY_LANG="$(notchy_language)"
export NOTCHY_LANG

t() {
    case "$NOTCHY_LANG" in
        pt) printf '%s' "$1" ;;
        es) printf '%s' "$3" ;;
        *) printf '%s' "$2" ;;
    esac
}

confirmed() {
    case "$1" in
        s|S|sim|Sim|SIM|y|Y|yes|Yes|YES|si|Si|SI|sí|Sí) return 0 ;;
        *) return 1 ;;
    esac
}

running() {
    pgrep -x Notchy >/dev/null
}

stop() {
    osascript -e "tell application id \"$BUNDLE\" to quit" >/dev/null 2>&1 || pkill -x Notchy
    for _ in $(seq 1 30); do
        running || return 0
        sleep 0.2
    done
    pkill -x Notchy
}

installed_version() {
    defaults read "$APP/Contents/Info" CFBundleShortVersionString 2>/dev/null
}

usage() {
    case "$NOTCHY_LANG" in
        pt) cat <<USAGE
uso: notchy [comando]

  (nada) / start     abre o Notchy
  setup              compila e instala o app (use depois de instalar ou atualizar pelo Homebrew)
  stop               fecha
  restart            reinicia
  status             rodando ou parado
  settings           abre os ajustes
  welcome            abre as boas-vindas e as permissões
  city "Cidade"      define a cidade do clima (city auto volta ao automático)
  doctor             diagnóstico de assinatura, certificado e permissões
  agents             agentes conectados ao notch
  agents enable X    conecta codex, gemini, copilot ou cursor (cursor --approvals aprova pelo notch)
  agents disable X   desconecta um agente
  update             baixa a versão mais nova e instala
  uninstall          remove o Notchy, os hooks do Claude Code e o comando
  version            versão instalada

Idioma: NOTCHY_LANG=pt|en|es
USAGE
        ;;
        es) cat <<USAGE
uso: notchy [comando]

  (nada) / start     abre Notchy
  setup              compila e instala la app (úsalo después de instalar o actualizar con Homebrew)
  stop               cierra
  restart            reinicia
  status             en ejecución o detenido
  settings           abre los ajustes
  welcome            abre la bienvenida y los permisos
  city "Ciudad"      define la ciudad del clima (city auto vuelve a la automática)
  doctor             diagnóstico de firma, certificado y permisos
  agents             agentes conectados al notch
  agents enable X    conecta codex, gemini, copilot o cursor (cursor --approvals aprueba desde el notch)
  agents disable X   desconecta un agente
  update             descarga la última versión y la instala
  uninstall          elimina Notchy, los hooks de Claude Code y el comando
  version            versión instalada

Idioma: NOTCHY_LANG=pt|en|es
USAGE
        ;;
        *) cat <<USAGE
usage: notchy [command]

  (none) / start     open Notchy
  setup              build and install the app (use after installing or upgrading with Homebrew)
  stop               quit
  restart            restart
  status             running or stopped
  settings           open settings
  welcome            open the welcome and permissions window
  city "City"        set the weather city (city auto goes back to automatic)
  doctor             check signature, certificate and permissions
  agents             coding agents connected to the notch
  agents enable X    connect codex, gemini, copilot or cursor (cursor --approvals approves from the notch)
  agents disable X   disconnect an agent
  update             download the latest version and install it
  uninstall          remove Notchy, the Claude Code hooks and this command
  version            installed version

Language: NOTCHY_LANG=pt|en|es
USAGE
        ;;
    esac
}

field() {
    local label="$1:"
    local width=16
    local pad=$(( width - ${#label} ))
    [ $pad -lt 1 ] && pad=1
    printf '%s%*s%s\n' "$label" "$pad" "" "$2"
}

doctor() {
    t "Notchy · diagnóstico" "Notchy · diagnostics" "Notchy · diagnóstico"
    echo
    echo
    if [ -d "$APP" ]; then
        field "App" "$APP (v$(installed_version))"
        info=$(codesign -dvv "$APP" 2>&1)
        if grep -q "Authority=$IDENTITY" <<<"$info"; then
            field "$(t "Assinatura" "Signature" "Firma")" "$IDENTITY ($(t "estável" "stable" "estable"))"
        elif grep -q "Signature=adhoc" <<<"$info"; then
            field "$(t "Assinatura" "Signature" "Firma")" "$(t "ad-hoc (instável: o macOS pede as permissões a cada atualização)" "ad-hoc (unstable: macOS asks for permissions after every update)" "ad-hoc (inestable: macOS pide los permisos en cada actualización)")"
        else
            field "$(t "Assinatura" "Signature" "Firma")" "$(grep -m1 Authority <<<"$info" || t "desconhecida" "unknown" "desconocida")"
        fi
        field "$(t "Requisito" "Requirement" "Requisito")" "$(codesign -dr - "$APP" 2>&1 | sed -n 's/^designated => //p')"
    else
        field "App" "$(t "não instalado" "not installed" "no instalada")"
    fi
    if security find-identity -v -p codesigning 2>/dev/null | grep -q "\"$IDENTITY\""; then
        field "$(t "Certificado" "Certificate" "Certificado")" "$(t "válido para assinar" "valid for signing" "válido para firmar")"
    elif security find-certificate -c "$IDENTITY" >/dev/null 2>&1; then
        field "$(t "Certificado" "Certificate" "Certificado")" "$(t "existe, mas o macOS não confia nele para assinar" "exists, but macOS doesn't trust it for signing" "existe, pero macOS no confía en él para firmar")"
    else
        field "$(t "Certificado" "Certificate" "Certificado")" "$(t "não existe" "missing" "no existe")"
    fi
    if [ -f "$STATE/keychain-ready" ]; then
        field "Keychain" "$(t "liberado para o codesign" "unlocked for codesign" "habilitado para codesign")"
    else
        field "Keychain" "$(t "ainda não liberado" "not unlocked yet" "aún no habilitado")"
    fi
    if running; then
        field "$(t "Rodando" "Running" "En ejecución")" "$(t "sim" "yes" "sí")"
    else
        field "$(t "Rodando" "Running" "En ejecución")" "$(t "não" "no" "no")"
    fi
    if [ -f "$STATE/source" ]; then
        field "$(t "Código-fonte" "Source" "Código fuente")" "$(cat "$STATE/source")"
    fi
    if [ -f "$STATE/status.json" ]; then
        echo
        t "Permissões (informadas pelo app):" "Permissions (reported by the app):" "Permisos (informados por la app):"
        echo
        /usr/bin/python3 - "$STATE/status.json" "$NOTCHY_LANG" <<'PY'
import json, sys
language = sys.argv[2]
texts = {
    "pt": {"granted": "permitido", "denied": "negado", "notDetermined": "não pedido", "notRunning": "app fechado", "notInstalled": "não instalado",
           "accessibility": "Acessibilidade", "calendar": "Calendário", "hooks": "hooks instalados", "nohooks": "hooks não instalados", "updated": "atualizado em"},
    "es": {"granted": "permitido", "denied": "denegado", "notDetermined": "no solicitado", "notRunning": "app cerrada", "notInstalled": "no instalada",
           "accessibility": "Accesibilidad", "calendar": "Calendario", "hooks": "hooks instalados", "nohooks": "hooks no instalados", "updated": "actualizado el"},
    "en": {"granted": "granted", "denied": "denied", "notDetermined": "not requested", "notRunning": "app closed", "notInstalled": "not installed",
           "accessibility": "Accessibility", "calendar": "Calendar", "hooks": "hooks installed", "nohooks": "hooks not installed", "updated": "updated at"},
}[language if language in ("pt", "es") else "en"]
data = json.load(open(sys.argv[1]))
def show(name, value):
    print(f"  {name:<16}{texts.get(value, value)}")
show(texts["accessibility"], data.get("accessibility", ""))
show(texts["calendar"], data.get("calendar", ""))
show("Bluetooth", data.get("bluetooth", ""))
for app, value in sorted(data.get("automation", {}).items()):
    show(app, value)
print(f"  {'Claude Code':<16}{texts['hooks'] if data.get('hooks') else texts['nohooks']}")
print(f"\n  {texts['updated']} {data.get('updatedAt', '?')}")
PY
    fi
}

source_dir() {
    if [ -n "${NOTCHY_SOURCE:-}" ] && [ -f "$NOTCHY_SOURCE/install.sh" ]; then
        echo "$NOTCHY_SOURCE"
    elif [ -f "$STATE/source" ] && [ -f "$(cat "$STATE/source")/install.sh" ]; then
        cat "$STATE/source"
    fi
}

setup() {
    local source
    source="$(source_dir)"
    if [ -z "$source" ]; then
        t "Não achei o código-fonte do Notchy. Rode notchy update ou instale pelo Homebrew." "Couldn't find Notchy's source. Run notchy update or install with Homebrew." "No encontré el código fuente de Notchy. Ejecuta notchy update o instálalo con Homebrew."
        echo
        exit 1
    fi
    exec "$source/install.sh" "$@"
}

update() {
    if [ "$HOMEBREW" = "1" ]; then
        brew upgrade notchy || brew upgrade --fetch-HEAD notchy || true
        exec "$(source_dir)/install.sh"
    fi
    local source=""
    [ -f "$STATE/source" ] && source="$(cat "$STATE/source")"
    if [ -z "$source" ] || [ ! -d "$source/.git" ]; then
        source="$HOME/Projects/notchy"
    fi
    if [ -d "$source/.git" ]; then
        printf "$(t "Atualizando %s" "Updating %s" "Actualizando %s")\n" "$source"
        git -C "$source" pull --ff-only || {
            printf "$(t "Não consegui atualizar com git pull. Confira as mudanças locais em %s e tente de novo." "git pull failed. Check the local changes in %s and try again." "No se pudo actualizar con git pull. Revisa los cambios locales en %s e inténtalo de nuevo.")\n" "$source"
            exit 1
        }
    elif [ -e "$source" ]; then
        printf "$(t "%s existe, mas não é um clone do GitHub." "%s exists, but it isn't a clone from GitHub." "%s existe, pero no es un clon de GitHub.")\n" "$source"
        printf "$(t "Renomeie a pasta e rode de novo: %s" "Rename the folder and run again: %s" "Cambia el nombre de la carpeta y vuelve a ejecutarlo: %s")\n" "mv \"$source\" \"$source-old\" && notchy update"
        exit 1
    else
        mkdir -p "$(dirname "$source")"
        git clone "$REPO_URL" "$source" || exit 1
    fi
    exec "$source/install.sh"
}

uninstall() {
    t "Isto remove:" "This removes:" "Esto elimina:"
    echo
    echo "  • /Applications/Notchy.app"
    echo "  • $(t "os hooks e a status line do Claude Code (a sua status line antiga volta)" "the Claude Code hooks and status line (your previous status line comes back)" "los hooks y la status line de Claude Code (tu status line anterior vuelve)")"
    echo "  • $(t "o comando notchy, as preferências e as permissões do Notchy" "the notchy command, Notchy's preferences and permissions" "el comando notchy, las preferencias y los permisos de Notchy")"
    printf "%s " "$(t "Continuar? [s/N]" "Continue? [y/N]" "¿Continuar? [s/N]")"
    read -r answer
    if ! confirmed "$answer"; then
        t "Nada foi removido." "Nothing was removed." "No se eliminó nada."
        echo
        exit 0
    fi

    running && stop
    if [ -f "$APP/Contents/Resources/hooks/install.py" ]; then
        /usr/bin/python3 "$APP/Contents/Resources/hooks/install.py" --uninstall
    elif [ -f "$HOME/.notchy/notchy-hook.py" ]; then
        t "Não achei o desinstalador dos hooks no app; rode python3 hooks/install.py --uninstall na pasta do projeto." "Couldn't find the hooks uninstaller in the app; run python3 hooks/install.py --uninstall in the project folder." "No encontré el desinstalador de los hooks en la app; ejecuta python3 hooks/install.py --uninstall en la carpeta del proyecto."
        echo
    fi
    for service in Accessibility AppleEvents Calendar BluetoothAlways; do
        tccutil reset "$service" "$BUNDLE" >/dev/null 2>&1
    done
    defaults delete "$BUNDLE" >/dev/null 2>&1
    rm -rf "$APP" "$STATE"
    t "App, hooks, preferências e permissões removidos." "App, hooks, preferences and permissions removed." "App, hooks, preferencias y permisos eliminados."
    echo

    if security find-certificate -c "$IDENTITY" >/dev/null 2>&1; then
        printf "$(t "Remover também o certificado \"%s\" do Keychain? [s/N]" "Also remove the \"%s\" certificate from the Keychain? [y/N]" "¿Eliminar también el certificado \"%s\" del Keychain? [s/N]") " "$IDENTITY"
        read -r answer
        if confirmed "$answer"; then
            security delete-identity -c "$IDENTITY" >/dev/null 2>&1 \
                || security delete-certificate -c "$IDENTITY" >/dev/null 2>&1
            t "Certificado removido." "Certificate removed." "Certificado eliminado."
            echo
        fi
    fi

    if [ "$HOMEBREW" = "1" ]; then
        t "Para remover o comando: brew uninstall notchy" "To remove the command: brew uninstall notchy" "Para eliminar el comando: brew uninstall notchy"
        echo
    else
        rm -f "$0" 2>/dev/null && t "Comando notchy removido." "notchy command removed." "Comando notchy eliminado." && echo
    fi
    t "Pronto. Obrigado por usar o Notchy." "Done. Thanks for using Notchy." "Listo. Gracias por usar Notchy."
    echo
}

say() {
    t "$1" "$2" "$3"
    echo
}

case "${1:-start}" in
    start|open)
        if [ ! -d "$APP" ]; then
            say "Notchy não está em /Applications. Rode o install.sh do projeto ou notchy update." "Notchy isn't in /Applications. Run the project's install.sh or notchy update." "Notchy no está en /Applications. Ejecuta el install.sh del proyecto o notchy update."
            exit 1
        fi
        open "$APP"
        ;;
    stop|quit)
        if running; then
            stop
            say "Notchy fechado" "Notchy closed" "Notchy cerrado"
        else
            say "Notchy não estava rodando" "Notchy wasn't running" "Notchy no estaba en ejecución"
        fi
        ;;
    restart)
        running && stop
        open "$APP"
        say "Notchy reiniciado" "Notchy restarted" "Notchy reiniciado"
        ;;
    status)
        if running; then
            say "Notchy rodando" "Notchy is running" "Notchy en ejecución"
        else
            say "Notchy parado" "Notchy is stopped" "Notchy detenido"
        fi
        ;;
    settings|ajustes)
        open "notchy://settings"
        ;;
    welcome|boas-vindas|bienvenida)
        open "notchy://welcome"
        ;;
    doctor|diagnostico)
        doctor
        ;;
    setup|install|instalar)
        shift
        setup "$@"
        ;;
    update|atualizar|actualizar)
        update
        ;;
    agents|agentes)
        shift
        installer="$APP/Contents/Resources/hooks/install.py"
        if [ ! -f "$installer" ]; then
            say "Notchy não está instalado em /Applications." "Notchy isn't installed in /Applications." "Notchy no está instalado en /Applications."
            exit 1
        fi
        [ $# -eq 0 ] && set -- list
        /usr/bin/python3 "$installer" --agents "$@"
        ;;
    uninstall|desinstalar)
        uninstall
        ;;
    version|versao|-v|--version)
        echo "Notchy $(installed_version)"
        ;;
    city|cidade|ciudad)
        shift
        if [ $# -eq 0 ]; then
            current=$(defaults read "$BUNDLE" weatherCity 2>/dev/null)
            printf "%s %s\n" "$(t "Cidade do clima:" "Weather city:" "Ciudad del clima:")" "${current:-$(t "automática (pela sua conexão)" "automatic (from your connection)" "automática (según tu conexión)")}"
            exit 0
        fi
        if [ "$1" = "auto" ]; then
            defaults delete "$BUNDLE" weatherCity >/dev/null 2>&1
            say "Clima voltou para a localização automática" "Weather is back to automatic location" "El clima volvió a la ubicación automática"
        else
            defaults write "$BUNDLE" weatherCity "$*"
            printf "%s %s\n" "$(t "Clima agora usa:" "Weather now uses:" "El clima ahora usa:")" "$*"
        fi
        if running; then
            stop
            open "$APP"
        fi
        ;;
    help|ajuda|ayuda|-h|--help)
        usage
        ;;
    *)
        usage
        exit 1
        ;;
esac
